    dd.date_key AS admitted_date_key,
    dt.time_key AS admitted_time_key,

    -- البيانات الوصفية (Metrics & Attributes)
    ie.primary_sdk,
    ie.provider_specialty,
    ie.admitted_at,
    ie.discharged_at,
    ie.is_active_encounter,
    ie.length_of_stay_days,
    ie.admission_type,
    ie.admission_location,
    ie.discharge_location,
    ie.total_cost,
    ie.payer_coverage,
    ie.coverage_percentage,
    ie.out_of_pocket_cost,
    ie.age_at_admission,
    ie.age_group,
    ie.discharge_status

FROM dev.dbt_dev.int_encounters ie
LEFT JOIN prod.dbt_dev_marts.dim_patients dp
    ON ie.patient_id = dp.patient_id
LEFT JOIN prod.dbt_dev_marts.dim_provider dpr
    ON ie.provider_id = dpr.provider_id
LEFT JOIN prod.dbt_dev_marts.dim_admission_type dat
    ON ie.admission_type = dat.admission_type
LEFT JOIN prod.dbt_dev_marts.dim_location dl_adm
    ON ie.admission_location = dl_adm.location_name
LEFT JOIN prod.dbt_dev_marts.dim_location dl_dis
    ON ie.discharge_location = dl_dis.location_name
LEFT JOIN prod.dbt_dev_marts.dim_date dd
    ON CAST(ie.admitted_at AS DATE) = dd.date_bk
LEFT JOIN prod.dbt_dev_marts.dim_time dt
    ON CAST(ie.admitted_at AS TIME) = dt.time_bk


WHERE ie.admitted_at > (SELECT MAX(admitted_at) FROM prod.dbt_dev_marts.fact_encounters)

  )
