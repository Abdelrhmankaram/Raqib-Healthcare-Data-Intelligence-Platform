SELECT
    md5(cast(coalesce(cast(lab_event_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS lab_event_id,
    md5(cast(coalesce(cast(patient_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS patient_id,
    md5(cast(coalesce(cast(admission_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS admission_id,
    md5(cast(coalesce(cast(provider_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS provider_id,

    md5(cast(coalesce(cast(specimen_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS specimen_id,
    le.item_id,

    le.lab_done_at as done_date_at,
    le.lab_stored_at as stored_date_at,

    le.result_value,
    le.measurement_unit,

    le.range_lower,
    le.range_higher,

    le.abnormal_flag,

FROM lab_events le

LEFT JOIN specimen_types st
    ON le.item_id = st.item_id
  )
