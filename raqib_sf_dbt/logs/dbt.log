        WHEN HOUR(time_key) < 12 THEN 'Morning'
        WHEN HOUR(time_key) < 18 THEN 'Afternoon'
        ELSE 'Evening'
    END AS time_of_day

FROM TABLE(GENERATOR(ROWCOUNT => 86400))
)
  )
