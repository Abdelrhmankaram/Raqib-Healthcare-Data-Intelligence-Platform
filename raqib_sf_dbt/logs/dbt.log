 by {{ partition_by }}\n            order by {{ order_by }}\n        ) = 1\n\n{%- endmacro -%}\n\n', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1780393076.0996041, 'supported_languages': None}, 'macro.dbt_utils.bigquery__deduplicate': {'name': 'bigquery__deduplicate', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/deduplicate.sql', 'original_file_path': 'macros/sql/deduplicate.sql', 'unique_id': 'macro.dbt_utils.bigquery__deduplicate', 'macro_sql': '\n{%- macro bigquery__deduplicate(relation, partition_by, order_by) -%}\n\n    select unique.*\n    from (\n        select\n            array_agg (\n                original\n                order by {{ order_by }}\n                limit 1\n            )[offset(0)] unique\n        from {{ relation }} original\n        group by {{ partition_by }}\n    )\n\n{%- endmacro -%}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1780393076.1000273, 'supported_languages': None}, 'macro.dbt_utils.pivot': {'name': 'pivot', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros/sql/pivot.sql', 'original_file_path': 'macros/sql/pivot.sql', 'unique_id': 'macro.dbt_utils.pivot', 'macro_sql': "{% macro pivot(column,\n               values,\n               alias=True,\n               agg='sum',\n               cmp='=',\n               prefix='',\n               suffix='',\n               then_value=1,\n               else_value=0,\n               quote_identifiers=True,\n               distinct=False) %}\n    {{ return(adapter.dispatch('pivot', 'dbt_utils')(column, values, alias, agg, cmp, prefix, suffix, then_value, else_value, quote_identifie