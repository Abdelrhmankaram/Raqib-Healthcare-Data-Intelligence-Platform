FROM (
SELECT
    DATEADD(DAY, SEQ4(), '2000-01-01'::DATE) AS date_bk,
    
    YEAR(date_bk) AS year,
    MONTH(date_bk) AS month,
    MONTHNAME(date_bk) AS month_name,
