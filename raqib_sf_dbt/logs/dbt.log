-- from services

with services as (

    select
        service_id,
        service_name,
        service_sub_type,
        category,
        row_number() over (
            partition by service_id
            order by service_name asc 
        ) as rn
    from dev.dbt_dev_staging.stg_services

)

select
    md5(cast(coalesce(cast(service_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as service_dim_key,
    service_id,
    service_name,
    service_sub_type,
    category
from services
where rn = 1
  )
