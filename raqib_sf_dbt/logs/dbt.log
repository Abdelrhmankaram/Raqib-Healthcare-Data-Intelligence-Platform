SELECT
    md5(cast(coalesce(cast(date_sk as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS date_key,
    year,
    month,
    month_name,
    day_name, 
    is_weekend 
FROM (
SELECT
    DATEADD(DAY, SEQ4(), '2000-01-01'::DATE) AS date_sk,
    
    YEAR(date_sk) AS year,
    MONTH(date_sk) AS month,
    MONTHNAME(date_sk) AS month_name,
    DAYNAME(date_sk) AS day_name,
    
    CASE 
        WHEN DAYOFWEEKISO(date_sk) IN (6, 7) THEN 1 
        ELSE 0 
    END AS is_weekend
FROM TABLE(GENERATOR(ROWCOUNT => 10000))
WHERE date_sk <= '2026-12-31'::DATE
)
  )
