2 }} - {{ radians_lon1 }}) / 2), 2))) * {{ conversion_rate }}\n\n{%- endmacro %}', 'depends_on': {'macros': ['macro.dbt_utils.degrees_to_radians']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1780497632.264467, 'supported_languages': None}}
