            admitted_out_timestamp
        ) AS stay_duration_hours,

        -- Admission details
        admission_type,
        admission_location,
        discharge_location,

        -- Financial metrics
        total_cost,
        payer_coverage,

        payer_coverage / NULLIF(total_cost, 0)
            AS coverage_percentage,

        total_cost - payer_coverage
            AS patient_out_of_pocket_cost,

        -- Patient age at encounter
        FLOOR(
            DATEDIFF(
            'year',
            birthdate,
            admitted_in_timestamp
            ) / 365.25
        ) AS age_at_admission,

        -- Useful flags
        CASE
            WHEN DATEDIFF(
                'day',
                admitted_in_timestamp,
                admitted_out_timestamp
            ) > 30
            THEN TRUE
            ELSE FALSE
        END AS long_stay_flag,

        CASE
            WHEN hospital_expire_flag
            THEN 'Deceased'
            ELSE 'Alive'
        END AS discharge_status

    FROM base

),

final_with_age_group AS (

    SELECT

        *,

        CASE
            WHEN age_at_admission < 12 THEN 'Child'
            WHEN age_at_admission BETWEEN 12 AND 17 THEN 'Teen'
            WHEN age_at_admission BETWEEN 18 AND 60 THEN 'Adult'
            ELSE 'Senior'
        END AS age_group

    FROM final

)

SELECT *
FROM final_with_age_group
  )
