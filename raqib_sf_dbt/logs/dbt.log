    FROM raw.public.lab_specimen_types
)

SELECT 
    itemid AS item_id,
    CASE 
        WHEN CONTAINS(label, '(') THEN TRIM(SPLIT_PART(label, '(', 1))
        ELSE label
    END AS label,
    CASE 
        WHEN CONTAINS(label, '(') THEN TRIM(REPLACE(SPLIT_PART(label, '(', 2), ')', ''))
        ELSE NULL
    END AS label_sub_type,
    fluid,
    CASE 
        WHEN CONTAINS(category, '–') THEN TRIM(SPLIT_PART(category, '–', 1))
        ELSE category
    END AS category_type,
    CASE   
        WHEN CONTAINS(category, '–') THEN TRIM(SPLIT_PART(category, '–', 2))
        ELSE NULL
    END AS category_sub_type,
    sub_domain_key,
    TRIM(SPLIT_PART(REGEXP_REPLACE(specialty, '\\s*/\\s*', ' & '), ' & ', 1)) AS specialty_1,
    NULLIF(TRIM(SPLIT_PART(REGEXP_REPLACE(specialty, '\\s*/\\s*', ' & '), ' & ', 2)), '') AS specialty_2,
    
FROM raw_lab_specimen_types
), lab_events AS (
    SELECT *
    FROM __dbt__cte__stg_lab_events
),

specimen_types AS (
    SELECT *
    FROM __dbt__cte__stg_lab_specimen_types
)

SELECT
    md5(cast(coalesce(cast(lab_event_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS lab_event_id,
    md5(cast(coalesce(cast(patient_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS patient_id,
    md5(cast(coalesce(cast(admission_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS admission_id,
    md5(cast(coalesce(cast(provider_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS provider_id,

    md5(cast(coalesce(cast(specimen_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS specimen_id,
    le.item_id,

    le.lab_done_at as done_date_at,
    le.lab_stored_at as stored_date_at,

    le.result_value,
    le.measurement_unit,

    le.range_lower,
    le.range_higher,

    le.abnormal_flag,

FROM lab_events le

LEFT JOIN specimen_types st
    ON le.item_id = st.item_id
  )
