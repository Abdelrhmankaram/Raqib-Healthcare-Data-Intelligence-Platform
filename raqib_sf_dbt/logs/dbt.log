LEFT JOIN readmission_flag rf
    ON p.patient_id = rf.patient_id

LEFT JOIN emergency_contacts ec
    ON p.patient_id = ec.patient_id

LEFT JOIN latest_status ls
    ON p.patient_id = ls.patient_id

