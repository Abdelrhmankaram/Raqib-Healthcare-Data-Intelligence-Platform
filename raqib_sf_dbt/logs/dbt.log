    ON lr.patient_id = dp.patient_id
LEFT JOIN prod.dbt_dev_marts.dim_provider dpr
    ON lr.provider_id = dpr.provider_id
LEFT JOIN prod.dbt_dev_marts.dim_lab_types dst
    ON lr.item_id = dst.item_id
LEFT JOIN prod.dbt_dev_marts.dim_date dd
    ON CAST(lr.lab_done_at AS DATE) = dd.date_bk
LEFT JOIN prod.dbt_dev_marts.dim_time dt
    ON CAST(lr.lab_done_at AS TIME) = dt.time_bk

    
    WHERE lr.lab_done_at > (SELECT MAX(lab_done_at) FROM prod.dbt_dev_marts.fact_lab_results)
    
  )
