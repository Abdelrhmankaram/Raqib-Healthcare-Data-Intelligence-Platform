    as (with __dbt__cte__stg_transfers as (
WITH raw_transfers AS (
    SELECT *
    FROM raw.public.transfers
)

SELECT 
    transfer_id,
    patient_id,
    admission_id,
    from_department,
    to_department,
    (from_department = to_department) AS is_same_department_transfer,
    CAST(transfer_datetime AS TIMESTAMP) AS transfer_datetime,
    transfer_reason
    
FROM raw_transfers
) SELECT
    md5(cast(coalesce(cast(t.transfer_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(t.patient_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(t.admission_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT))                                       AS transfer_key,

    t.transfer_id,
    dp.patient_key,
    ie.encounter_key,
    dd.date_key                                 AS transfer_date_key,
    dt.time_key                                 AS transfer_time_key,
    t.from_department,
    t.to_department,
    t.is_same_department_transfer,
    t.transfer_reason

FROM __dbt__cte__stg_transfers t
LEFT JOIN prod.dbt_dev_marts.dim_patients dp
    ON t.patient_id = dp.patient_id
LEFT JOIN dev.dbt_dev.int_encounters ie
    ON t.admission_id = ie.admission_id
LEFT JOIN prod.dbt_dev_marts.dim_date dd
    ON CAST(t.transfer_datetime AS DATE) = dd.date_bk
LEFT JOIN prod.dbt_dev_marts.dim_time dt
    ON CAST(t.transfer_datetime AS TIME) = dt.time_bk
    )

