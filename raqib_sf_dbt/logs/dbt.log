    REGEXP_SUBSTR(description, '\\(([^)]+)\\)', 1, 1, 'e', 1) AS description_type,
    TRIM(SPLIT_PART(REGEXP_REPLACE(SPLIT_PART(sub_domain, ' – ', 2), '\\s*/\\s*', ' & '), ' & ', 1)) AS domain,
    NULLIF(TRIM(SPLIT_PART(REGEXP_REPLACE(SPLIT_PART(sub_domain, ' – ', 2), '\\s*/\\s*', ' & '), ' & ', 2)), '') AS sub_domain
FROM raw_diagnosis
), dim_diagnosis as (
    select * from __dbt__cte__stg_diagnosis
)

select 
    md5(cast(coalesce(cast(diagnosis_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(domain as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(sub_domain_key as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as diagnosis_key,
    description,
    description_type,
    sub_domain_key
    domain,
    sub_domain
from dim_diagnosis
  )
