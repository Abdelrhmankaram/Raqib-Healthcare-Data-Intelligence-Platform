  as (
    

WITH services AS (
    SELECT *
    FROM dev.dbt_dev_staging.stg_services
    WHERE rn = 1
)

SELECT
    md5(cast(coalesce(cast(s.service_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(s.patient_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(s.admission_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS service_key,
    dp.patient_key,
    ie.encounter_key,
    dse.service_dim_key,
    s.cost,
    s.service_duration_in_minutes

FROM services s
LEFT JOIN prod.dbt_dev_marts.dim_patients dp
    ON s.patient_id = dp.patient_id
LEFT JOIN dev.dbt_dev.int_encounters ie
    ON s.admission_id = ie.admission_id
LEFT JOIN prod.dbt_dev_marts.dim_services dse
    ON s.service_id = dse.service_id


  WHERE md5(cast(coalesce(cast(s.service_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(s.patient_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(s.admission_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) 
        NOT IN (SELECT service_key FROM prod.dbt_dev_marts.fact_patient_services)

  )
