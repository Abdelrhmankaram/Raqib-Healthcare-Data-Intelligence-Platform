SELECT 
    admission_id,
    patient_id,
    admission_provider_id                                       AS provider_id,
    CAST(ADMISSION_DATETIME_IN AS TIMESTAMP)                    AS admitted_at,
    CAST(ADMISSION_DATETIME_OUT AS TIMESTAMP)                   AS discharged_at,
    UPPER(LEFT(admission_type, 1)) 
        || LOWER(SUBSTR(admission_type, 2))                     AS admission_type,
    admission_location,
    discharge_location,
    INITCAP(insurance_type)                                     AS insurance_type,
    total_cost,
    payer_coverage,
    hospital_expire_flag,
    primary_sdk
FROM raw_admissions
), dim_admission_type as (
    select distinct admission_type as admission_type from __dbt__cte__stg_admissions
)

select 
md5(cast(coalesce(cast(admission_type as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as admission_type_Key,
*
from dim_admission_type
    )

