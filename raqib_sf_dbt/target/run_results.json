_NAME,\r\n\r\n    CASE\r\n        WHEN DAYOFWEEKISO(Date_Val) IN (6, 7) THEN 1\r\n        ELSE 0\r\n    END AS IS_WEEKEND\r\n\r\nFROM Dates\r\nWHERE Date_Val <= '2026-12-31'::DATE\r\nORDER BY DATE_KEY", "relation_name": "prod.dbt_dev_marts.dim_date", "batch_results": null}], "elapsed_time": 4.262566328048706, "args": {"print": true, "log_level": "info", "printer_width": 80, "strict_mode": false, "indirect_selection": "eager", "vars": {}, "favor_state": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "static_parser": true, "which": "run", "require_unique_project_resource_names": false, "state_modified_compare_more_unrendered_values": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "invocation_command": "dbt run --select dim_date", "log_path": "D:\\Raqib\\raqib_sf_dbt\\logs", "quiet": false, "require_generic_test_arguments_property": true, "require_batched_execution_for_custom_microbatch_strategy": false, "skip_nodes_if_on_run_start_fails": false, "profiles_dir": "D:\\Raqib\\raqib_sf_dbt", "require_resource_names_without_spaces": true, "show_resource_report": false, "show_all_deprecations": false, "project_dir": "D:\\Raqib\\raqib_sf_dbt", "introspect": true, "populate_cache": true, "require_yaml_configuration_for_mf_time_spines": false, "source_freshness_run_project_hooks": true, "state_modified_compare_vars": false, "log_format": "default", "log_format_file": "debug", "log_level_file": "debug", "exclude": [], "cache_selected_only": false, "version_check": true, "empty": false, "require_nested_cumulative_type_params": false, "use_colors": true, "use_colors_file": true, "partial_parse": true, "require_ref_searches_node_package_before_root": false, "send_anonymous_usage_stats": true, "upload_to_artifacts_ingest_api": false, "require_all_warnings_handled_by_warn_error": false, "use_fast_test_edges": false, "log_file_max_bytes": 10485760, "require_explicit_package_overrides_for_builtin_materializations": true, "write_js