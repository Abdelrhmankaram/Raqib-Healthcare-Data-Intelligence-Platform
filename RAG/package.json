{
  "name": "rag-chatbot",
  "version": "1.0.0",
  "description": "RAG-based chatbot web application",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node test.js",
    "start:all": "npm run start-chromadb && npm start",
    "start-chromadb": "docker run -d -p 8000:8000 --name chromadb chromadb/chroma || echo 'Docker not available or ChromaDB already running'",
    "start-chromadb-windows": "start-chromadb.bat"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "chromadb": "^1.8.1",
    "@langchain/textsplitters": "^0.0.3",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}